# ─── REQUIRED ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → your project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── OPTIONAL ──────────────────────────────────────────────────────────────────
# Enables automatic RC plate lookup on the "Add Vehicle" screen.
# Without this key the screen shows a manual entry form — everything else works.
# Get from: https://rapidapi.com → sign up free → copy your default app key.
# Then subscribe (free tier) to: "RTO Vehicle Information Verification India"
EXPO_PUBLIC_RAPIDAPI_KEY=

# AI features (diary analysis, anomaly detection) require Anthropic API key set
# as a secret in Supabase Edge Functions, NOT here in the app env.
# Run:  npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
